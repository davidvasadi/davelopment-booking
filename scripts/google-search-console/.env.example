# Ugyanaz az OAuth kliens újrahasználható, amit a Google Ads API-hoz
# hoztunk létre (Google Cloud Console → davelopment projekt → APIs &
# Services → Credentials → "davelopment-ads-desktop" Desktop OAuth client)
# — lásd scripts/google-ads/.env. Az OAuth kliens nincs egy konkrét API-hoz
# kötve, csak a scope-tól függ, mihez kér engedélyt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A get_refresh_token.py generálja (Search Console readonly scope-pal) —
# NEM ugyanaz, mint a Google Ads refresh token, mert más scope-ot kért.
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# A Search Console property pontos azonosítója. Domain property esetén
# "sc-domain:davelopment.hu", URL-prefix property esetén a teljes URL
# (pl. "https://davelopment.hu/") — a Search Console UI címsorában látszik,
# melyik van beállítva.
SEARCH_CONSOLE_SITE_URL=sc-domain:davelopment.hu

# Opcionális: a beküldendő sitemap teljes URL-je. Ha üres, a SEARCH_CONSOLE_SITE_URL-ből
# számolja (sc-domain:davelopment.hu → https://davelopment.hu/sitemap.xml).
SEARCH_CONSOLE_SITEMAP_URL=
