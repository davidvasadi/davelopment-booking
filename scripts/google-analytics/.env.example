# Ugyanaz az OAuth kliens újrahasználható, amit a Google Ads API-hoz és a
# Search Console-hoz is használunk (Google Cloud Console → davelopment
# projekt → APIs & Services → Credentials → "davelopment-ads-desktop"
# Desktop OAuth client) — lásd scripts/google-ads/.env. Az OAuth kliens
# nincs egy konkrét API-hoz kötve, csak a scope-tól függ, mihez kér
# engedélyt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A get_refresh_token.py generálja (Analytics readonly scope-pal) — NEM
# ugyanaz, mint a Google Ads vagy Search Console refresh token, mert más
# scope-ot kért.
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# A GA4 property numerikus azonosítója (NEM a Measurement ID, ami G-XXXX
# formátumú!). Megtalálható: GA4 Admin (bal lent fogaskerék) → Property
# Settings → "PROPERTY ID" mező, egy sima szám, pl. 123456789.
GA4_PROPERTY_ID=
