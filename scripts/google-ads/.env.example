# Copy to .env and fill in — see docs/google-ads-api-setup.md for where each value comes from.
# Note: Google sunset developer tokens on 2026-09-09 — none needed anymore,
# access is governed by the Google Cloud project's access level instead.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Only needed if the account is accessed through a manager (MCC) account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# The actual ad account to read, digits only (no dashes):
GOOGLE_ADS_CUSTOMER_ID=
