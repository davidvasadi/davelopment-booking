# Places API (New) kulcs — ugyanaz, mint a [davelopment]® fő repóban
# (scripts/google-reviews/.env), mivel ugyanahhoz a Google Cégem-profilhoz
# tartozik mindkét termék.
GOOGLE_PLACES_API_KEY=

# A davelopment Google Cégem-profil Place ID-ja — ugyanaz, mint a fő repóban.
GOOGLE_PLACE_ID=

# A Booking repo public mappája flat struktúrájú (nincs külön frontend/
# alkönyvtár, mint a fő repóban) — ezért itt kötelező expliciten megadni.
GOOGLE_RATING_PUBLIC_DIR=
